# PhD Shortlist Builder — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.

# ── Required ──────────────────────────────────────────────────────────────────
# Google Gemini API key (free tier) — used for Stage 1 parsing and Stage 5 why-match generation
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Semantic Scholar API key increases rate limit from ~1 req/s to 10 req/s
# Get one free at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# TOP_N_FOR_WHY_MATCH — how many top candidates get LLM why-match blurbs (default: 50)
# Set to a lower value (e.g. 10) for faster test runs
# TOP_N_FOR_WHY_MATCH=10
